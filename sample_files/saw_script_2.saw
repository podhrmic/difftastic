// A small verification script with embedded Cryptol.
let {{
  increment : [16] -> [16]
  increment x = x + 2
}};

let input_type = {| [16] |};
let expected = {{ \x -> x + 2 }};
let options = { label = "increment", counts = [1, 2, 3] };

let spec = do {
  x <- llvm_fresh_var "x" (llvm_int 16);
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ increment x }});
};

m <- llvm_load_module "increment.bc";
llvm_verify m "increment" [] false spec (do { abc; });
