// A small verification script with embedded Cryptol.
let {{
  increment : [8] -> [8]
  increment x = x + 1
}};

let input_type = {| [8] |};
let expected = {{ \x -> x + 1 }};
let options = { label = "increment", counts = [1, 2] };

let spec = do {
  x <- llvm_fresh_var "x" (llvm_int 8);
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ increment x }});
};

m <- llvm_load_module "increment.bc";
llvm_verify m "increment" [] false spec (do { z3; });
